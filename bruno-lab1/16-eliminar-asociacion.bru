delete {
  url: {{baseUrl}}/api/productos/1/etiquetas/{{etiqueta1Id}}
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Queda solo la otra etiqueta", function () { expect(res.getBody().etiquetas).to.have.lengthOf(1); expect(res.getBody().etiquetas[0].nombre).to.equal("Importado"); });
}
