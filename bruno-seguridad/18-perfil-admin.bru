meta {
  name: S18 GET perfil token ADMIN - RETO OPCIONAL
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/auth/perfil
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

tests {
  test("200 OK", function () { expect(res.getStatus()).to.equal(200); });
  test("Devuelve el usuario y sus roles del JWT", function () { expect(res.getBody().usuario).to.equal("admin"); expect(res.getBody().roles).to.include("ADMIN"); });
}
