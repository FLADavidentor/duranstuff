meta {
  name: Paso 12 - Proveedor 1
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/proveedores
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Tecnologia Central",
    "telefono": "2222-1000",
    "correo": "ventas@tecnologia-central.example",
    "activo": true
  }
}

script:post-response {
  bru.setVar("proveedor1Id", res.getBody().id);
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Proveedor guardado", function () { expect(res.getBody().id).to.be.a("number"); expect(res.getBody().nombre).to.equal("Tecnologia Central"); expect(res.getBody().activo).to.equal(true); });
}
