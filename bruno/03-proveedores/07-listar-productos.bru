meta {
  name: Paso 12 - Productos con categoria y proveedor
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/productos
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Relaciones persistidas", function () { const rows = res.getBody(); expect(rows).to.have.lengthOf(2); const lap = rows.find(p => p.codigo === "LAP-001"); const mouse = rows.find(p => p.codigo === "MOU-001"); expect(lap.categoria.nombre).to.equal("Computadoras"); expect(lap.proveedor.nombre).to.equal("Tecnologia Central"); expect(lap.precioVenta).to.equal(850); expect(mouse.categoria.nombre).to.equal("Accesorios"); expect(mouse.proveedor.nombre).to.equal("Suministros Digitales"); expect(mouse.precioVenta).to.equal(25); });
}
