meta {
  name: P09 POST Accesorios
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/categorias
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Accesorios",
    "activa": true
  }
}

script:post-response {
  bru.setVar("accesoriosId", res.getBody().id);
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Categoria guardada", function () { expect(res.getBody().nombre).to.equal("Accesorios"); });
}
