meta {
  name: Paso 9 - Tres categorias
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/categorias
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Tres categorias esperadas", function () { expect(res.getBody().map(c => c.nombre)).to.have.members(["Computadoras", "Accesorios", "Monitores"]); });
}
