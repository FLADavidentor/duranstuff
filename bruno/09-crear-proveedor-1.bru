meta {
  name: P12 POST Proveedor 1
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/proveedores
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Tecnologia Central",
    "telefono": "2222-1000",
    "correo": "ventas@tecnologia-central.com",
    "activo": true
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Proveedor guardado", function () { expect(res.getBody().nombre).to.equal("Tecnologia Central"); });
}
