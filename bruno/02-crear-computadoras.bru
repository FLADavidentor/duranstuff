meta {
  name: P09 POST Computadoras
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/categorias
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Computadoras",
    "activa": true
  }
}

script:post-response {
  bru.setVar("computadorasId", res.getBody().id);
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Categoria guardada", function () { expect(res.getBody().nombre).to.equal("Computadoras"); });
}
