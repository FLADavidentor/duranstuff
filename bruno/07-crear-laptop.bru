meta {
  name: P11 POST LAP-001 Laptop
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/productos
  body: json
  auth: none
}

body:json {
  {
    "codigo": "LAP-001",
    "nombre": "Laptop Lenovo",
    "categoria": {
        "id": 1
    },
    "precioVenta": 850.00,
    "existencia": 10
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Producto guardado", function () { expect(res.getBody().codigo).to.equal("LAP-001"); expect(res.getBody().categoria.id).to.equal(1); });
}
