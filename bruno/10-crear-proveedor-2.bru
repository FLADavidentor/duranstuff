meta {
  name: P12 POST Proveedor 2
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/proveedores
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Suministros Digitales",
    "telefono": "2222-2000",
    "correo": "ventas@suministros-digitales.com",
    "activo": true
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Proveedor guardado", function () { expect(res.getBody().nombre).to.equal("Suministros Digitales"); });
}
